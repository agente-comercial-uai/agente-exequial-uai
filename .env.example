# ============================================================================
# Variables de entorno — Proyecto Agente Conversacional Exequial
# Copia este archivo a .env y completa los valores vacíos.
# NUNCA subas el archivo .env con valores reales a GitHub.
# ============================================================================

# Clave de Google Generative AI (opcional en desarrollo, obligatoria con modelo real)
GOOGLE_API_KEY=

# Modelo de lenguaje por defecto
MODELO=gemini-3.5-flash-lite

# URL de Redis (opcional; si no hay servidor, se usa memoria RAM)
REDIS_URL=redis://localhost:6379/0

# Tiempo de vida del caché en segundos (opcional)
CACHE_TTL_SEGUNDOS=3600

# Token de tu bot de Telegram (obtén el token de @BotFather)
TELEGRAM_TOKEN=

# Secreto para validar webhooks de Telegram (definido por ti)
TELEGRAM_SECRET=

# Token de acceso para POST /chat (cabecera: Authorization: Bearer <API_TOKEN>)
# Valor ficticio de ejemplo; en producción usa uno propio y no lo subas.
API_TOKEN=TU_TOKEN_DE_PRUEBA_FICTICIO

# URL pública del servicio (obligatoria en Heroku para el webhook de Telegram)
PUBLIC_URL=
